# LLM
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASEURL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Embedding (如果和 LLM 用同一个 API，可以不设置下面两项)
OPENAI_EMBEDDING_API_KEY=your_embedding_api_key
OPENAI_EMBEDDING_BASEURL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cohere Rerank
COHERE_API_KEY=your_cohere_api_key

# Database
DATABASE_URL=postgresql://rag_admin:rag_password_dev@localhost:5432/enterprise_rag

# App
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.7
